<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             x:Class="SafeFile.Views.DecryptView"
             x:DataType="vm:DecryptViewModel"
             Foreground="{DynamicResource PrimaryTextBrush}">
  <UserControl.Styles>
    <Style Selector="Border.source-drop-zone">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
    </Style>
    <Style Selector="Border.source-drop-zone.drag-active">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,16,24,24" Spacing="16">

        <!-- Unified file/folder picker -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16"
                IsEnabled="{Binding !IsDecrypting}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Tr DecryptData}"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr DecryptSelectionHint}"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}"
                         VerticalAlignment="Center" Foreground="{DynamicResource TertiaryTextBrush}"
                         FontWeight="Medium"/>
            </Grid>

            <Border x:Name="DropZone" Classes="source-drop-zone"
                    Height="122" BorderThickness="2" CornerRadius="6"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragLeave="OnDragLeave"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop">
              <Grid ColumnDefinitions="*,Auto" Margin="22,12">
                <StackPanel VerticalAlignment="Center" Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource FolderIcon}"
                              Width="28" Height="28"
                              Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{loc:Tr DropDecryptSources}"
                                 FontSize="13" FontWeight="Medium"/>
                      <TextBlock Text="{loc:Tr DuplicatesIgnored}"
                                 FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="8">
                  <Button Theme="{StaticResource PrimaryButtonTheme}"
                          Command="{Binding BrowseSourceCommand}">
                    <TextBlock Text="{loc:Tr SelectFiles}"/>
                  </Button>
                  <Button Theme="{StaticResource OutlinedButtonTheme}"
                          Command="{Binding BrowseSourceFolderCommand}">
                    <TextBlock Text="{loc:Tr SelectFolder}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16"
                IsVisible="{Binding HasFolderSources}" IsEnabled="{Binding !IsDecrypting}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Tr ExcludedFolders}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Tr DecryptExcludedFoldersHint}" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </StackPanel>
              <Button Grid.Column="1" Margin="8,0" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding ClearExcludedFoldersCommand}"
                      IsVisible="{Binding HasExcludedFolders}" Content="{loc:Tr ClearAll}"/>
              <Button Grid.Column="2" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding BrowseExcludedFoldersCommand}" Content="{loc:Tr AddFolders}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding ExcludedFolders}" IsVisible="{Binding HasExcludedFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="5" Padding="10,6" Margin="0,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding FullPath}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding FullPath}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding RemoveCommand}"
                              Theme="{StaticResource OutlinedButtonTheme}" Content="×"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Batch queue -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{loc:Tr VaultList}" FontSize="16"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="10" Padding="8,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasItems}">
                  <TextBlock Text="{Binding SelectionSummary}"
                             FontSize="11" Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"/>
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding ClearItemsCommand}"
                      IsEnabled="{Binding !IsDecrypting}"
                      IsVisible="{Binding HasItems}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource CancelCircleIcon}"
                            Width="14" Height="14"/>
                  <TextBlock Text="{loc:Tr ClearAll}"/>
                </StackPanel>
              </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5,5,0,0" Padding="10,8">
              <Grid ColumnDefinitions="40,8,2*,12,2*,12,85,12,145,12,110,36"
                    ClipToBounds="True">
                <TextBlock Text="{loc:Tr Number}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{loc:Tr Vault}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="{loc:Tr OriginalFileName}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="6" Text="{loc:Tr Size}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="8" Text="{loc:Tr Progress}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="10" Text="{loc:Tr Status}"
                           FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                      CornerRadius="0,0,5,5" Height="224"
                      IsVisible="{Binding !HasItems}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="7">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="30"
                            Height="30" Foreground="{DynamicResource DisabledTextBrush}"/>
                  <TextBlock Text="{loc:Tr NoVaults}"
                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <TextBlock Text="{loc:Tr SelectToBegin}"
                             FontSize="11" Foreground="{DynamicResource DisabledTextBrush}"/>
                </StackPanel>
              </Border>

              <ListBox ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem}"
                       Height="224"
                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                       IsVisible="{Binding HasItems}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecryptQueueItem">
                    <Grid ColumnDefinitions="40,8,2*,12,2*,12,85,12,145,12,110,36"
                          MinHeight="48" Margin="6,2" ClipToBounds="True">
                      <TextBlock Text="{Binding SequenceNumber}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                      <TextBlock Grid.Column="2" Text="{Binding VaultName}"
                                 TextTrimming="CharacterEllipsis"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding VaultName}"/>
                      <TextBlock Grid.Column="4"
                                 Text="{Binding OriginalFileName}"
                                 TextTrimming="CharacterEllipsis"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding OriginalFileName}"/>
                      <TextBlock Grid.Column="6"
                                 Text="{Binding VaultSizeText}"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TertiaryTextBrush}"/>
                      <StackPanel Grid.Column="8" Spacing="3"
                                  VerticalAlignment="Center"
                                  ClipToBounds="True">
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"/>
                        <ProgressBar Height="8" MinWidth="0"
                                     HorizontalAlignment="Stretch"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding Progress}"
                                     ClipToBounds="True"/>
                      </StackPanel>
                      <TextBlock Grid.Column="10" Text="{Binding Status}"
                                 Foreground="{Binding StatusForeground}"
                                 FontSize="11" FontWeight="Medium"
                                 TextWrapping="Wrap"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding ErrorMessage}"/>
                      <Button Grid.Column="11" Width="28" Height="28"
                              Padding="0" Background="Transparent"
                              Command="{Binding RemoveCommand}"
                              IsEnabled="{Binding !IsLocked}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Tr RemoveFromList}">
                        <TextBlock Text="×" FontSize="18"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>

        <!-- Password, options and selected-item details -->
        <Grid ColumnDefinitions="3*,16,2*">
          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16"
                  VerticalAlignment="Top"
                  IsEnabled="{Binding !IsDecrypting}">
            <StackPanel Spacing="14">
              <TextBlock Text="{loc:Tr SecurityAndOptions}"
                         FontSize="16" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Password}"
                         PasswordChar="{Binding PasswordChar}"
                         PlaceholderText="{loc:Tr DecryptPasswordPlaceholder}"/>
                <Button Grid.Column="1" Margin="6,0,0,0" Width="40"
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding TogglePasswordVisibilityCommand}">
                  <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding CheckPasswordCommand}"
                        IsEnabled="{Binding !IsDecrypting}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource LockIcon}" Width="15" Height="15"/>
                    <TextBlock Text="{loc:Tr VerifyAll}"/>
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding PasswordCheckMessage}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{Binding PasswordCheckForeground}"/>
              </Grid>

              <Border Background="{DynamicResource SubtleSurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <CheckBox Content="{loc:Tr OverwriteExisting}"
                            IsChecked="{Binding OverwriteExisting}"/>
                  <CheckBox Grid.Column="1" Content="{loc:Tr OpenFolderOnCompletion}"
                            IsChecked="{Binding OpenFolderWhenDone}"/>
                </Grid>
              </Border>

              <Separator/>

              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"
                         IsVisible="{Binding HasStatusMessage}"/>

              <StackPanel Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right">
                <Button
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding ResetCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource RefreshIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="{loc:Tr Reset}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding OpenOutputFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource FolderIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="{loc:Tr OpenOutputFolder}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button
                        Theme="{StaticResource PrimaryButtonTheme}"
                        Command="{Binding DecryptCommand}"
                        IsEnabled="{Binding !IsDecrypting}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource LockOpenIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="{loc:Tr DecryptNow}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10">
            <StackPanel Spacing="14" Margin="6">
              <TextBlock Text="{loc:Tr FileDetails}"
                         FontSize="16" FontWeight="SemiBold"/>
                <Grid MinHeight="245">
                  <TextBlock Text="{loc:Tr SelectVaultForDetails}"
                             Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasSelectedItem}"/>
                  <StackPanel Spacing="9" IsVisible="{Binding HasSelectedItem}">
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Vault}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailVaultName}"
                                 FontWeight="SemiBold"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding DetailVaultPath}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr OriginalFileName}"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding DetailOriginalFileName}"
                                 FontWeight="SemiBold"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding DetailOriginalFileName}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Format}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailFormat}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Mode}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailMode}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Chunk"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailChunkSize}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="KDF"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailKdf}"
                                 TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Algorithm}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailAlgorithm}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Size}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailVaultSize}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Modified}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailModifiedTime}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="{loc:Tr Status}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailStatus}"
                                 FontWeight="SemiBold"/>
                    </Grid>
                    <Border Background="{DynamicResource ErrorSubtleBrush}" CornerRadius="4" Padding="8"
                            IsVisible="{Binding HasDetailError}">
                      <TextBlock Text="{Binding DetailError}" Foreground="{DynamicResource ErrorBrush}"
                                 TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                  </StackPanel>
                </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" IsVisible="{Binding IsStatusBarVisible}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="250,*,56,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{Binding StatusAction}"
                     FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StatusCurrentFile}" FontSize="11"
                     Foreground="{DynamicResource TertiaryTextBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding StatusDetails}" FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <ProgressBar Grid.Column="1" Height="8" Margin="16,0"
                     Minimum="0" Maximum="1"
                     Value="{Binding StatusProgress}" CornerRadius="4"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                   Text="{Binding StatusProgressPercent, StringFormat={}{0}%}"/>
        <Button Grid.Column="3" Theme="{StaticResource CancelButtonTheme}"
                Command="{Binding CloseStatusCommand}">
          <PathIcon Data="{StaticResource CancelCircleIcon}"
                    Width="18" Height="18"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
