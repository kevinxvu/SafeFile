<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             x:Class="SafeFile.Views.DecryptView"
             x:DataType="vm:DecryptViewModel"
             Foreground="#1F2937">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24" Spacing="16">

        <!-- Unified file/folder picker -->
        <Border Background="White" CornerRadius="8" Padding="16"
                IsEnabled="{Binding !IsDecrypting}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Dữ liệu cần giải mã"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Chọn một file, nhiều file hoặc toàn bộ thư mục vault."
                           FontSize="12" Foreground="#6B7280"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}"
                         VerticalAlignment="Center" Foreground="#4B5563"
                         FontWeight="Medium"/>
            </Grid>

            <Border x:Name="DropZone"
                    Height="122" BorderBrush="#CBD5E1" BorderThickness="2"
                    CornerRadius="6" Background="#F8FAFC"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragLeave="OnDragLeave"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop">
              <Grid ColumnDefinitions="*,Auto" Margin="22,12">
                <StackPanel VerticalAlignment="Center" Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource FolderIcon}"
                              Width="28" Height="28" Foreground="#64748B"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Kéo thả các file .safe hoặc thư mục vào đây"
                                 FontSize="13" FontWeight="Medium"/>
                      <TextBlock Text="Các file trùng sẽ tự động được bỏ qua."
                                 FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="8">
                  <Button Theme="{StaticResource PrimaryButtonTheme}"
                          Command="{Binding BrowseSourceCommand}">
                    <TextBlock Text="Chọn file"/>
                  </Button>
                  <Button Theme="{StaticResource OutlinedButtonTheme}"
                          Command="{Binding BrowseSourceFolderCommand}">
                    <TextBlock Text="Chọn thư mục"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Batch queue -->
        <Border Background="White" CornerRadius="8" Padding="16">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Danh sách vault" FontSize="16"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2"
                        IsVisible="{Binding HasItems}">
                  <TextBlock Text="{Binding SelectionSummary}"
                             FontSize="11" Foreground="#2563EB"/>
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding ClearItemsCommand}"
                      IsEnabled="{Binding !IsDecrypting}"
                      IsVisible="{Binding HasItems}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource CancelCircleIcon}"
                            Width="14" Height="14"/>
                  <TextBlock Text="Xóa tất cả"/>
                </StackPanel>
              </Button>
            </Grid>

            <Border Grid.Row="1" Background="#F8FAFC"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="5,5,0,0" Padding="10,8">
              <Grid ColumnDefinitions="2*,12,2*,12,85,12,145,12,110,36"
                    ClipToBounds="True">
                <TextBlock Text="Vault" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Tên file gốc"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Dung lượng"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="6" Text="Tiến trình"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="8" Text="Trạng thái"
                           FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <Border BorderBrush="#E5E7EB" BorderThickness="1,0,1,1"
                      CornerRadius="0,0,5,5" Height="224"
                      IsVisible="{Binding !HasItems}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="7">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="30"
                            Height="30" Foreground="#94A3B8"/>
                  <TextBlock Text="Chưa có vault nào trong danh sách"
                             Foreground="#64748B"/>
                  <TextBlock Text="Chọn file, thư mục hoặc kéo thả để bắt đầu."
                             FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
              </Border>

              <ListBox ItemsSource="{Binding Items}"
                       SelectedItem="{Binding SelectedItem}"
                       Height="224"
                       BorderBrush="#E5E7EB" BorderThickness="1,0,1,1"
                       IsVisible="{Binding HasItems}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecryptQueueItem">
                    <Grid ColumnDefinitions="2*,12,2*,12,85,12,145,12,110,36"
                          MinHeight="48" Margin="6,2" ClipToBounds="True">
                      <TextBlock Text="{Binding VaultName}"
                                 TextTrimming="CharacterEllipsis"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding VaultName}"/>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding OriginalFileName}"
                                 TextTrimming="CharacterEllipsis"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding OriginalFileName}"/>
                      <TextBlock Grid.Column="4"
                                 Text="{Binding VaultSizeText}"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 Foreground="#4B5563"/>
                      <StackPanel Grid.Column="6" Spacing="3"
                                  VerticalAlignment="Center"
                                  ClipToBounds="True">
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"/>
                        <ProgressBar Height="8" MinWidth="0"
                                     HorizontalAlignment="Stretch"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding Progress}"
                                     ClipToBounds="True"/>
                      </StackPanel>
                      <TextBlock Grid.Column="8" Text="{Binding Status}"
                                 Foreground="{Binding StatusForeground}"
                                 FontSize="11" FontWeight="Medium"
                                 TextWrapping="Wrap"
                                 ClipToBounds="True"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding ErrorMessage}"/>
                      <Button Grid.Column="9" Width="28" Height="28"
                              Padding="0" Background="Transparent"
                              Command="{Binding RemoveCommand}"
                              IsEnabled="{Binding !IsLocked}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Xóa khỏi danh sách">
                        <TextBlock Text="×" FontSize="18"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>

        <!-- Password, options and selected-item details -->
        <Grid ColumnDefinitions="3*,16,2*">
          <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16"
                  VerticalAlignment="Top"
                  IsEnabled="{Binding !IsDecrypting}">
            <StackPanel Spacing="14">
              <TextBlock Text="Bảo mật và tuỳ chọn"
                         FontSize="16" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Password}"
                         PasswordChar="{Binding PasswordChar}"
                         PlaceholderText="Nhập mật khẩu dùng cho các vault..."/>
                <Button Grid.Column="1" Margin="6,0,0,0" Width="40"
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding TogglePasswordVisibilityCommand}">
                  <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
                </Button>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding CheckPasswordCommand}"
                        IsEnabled="{Binding !IsDecrypting}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource LockIcon}" Width="15" Height="15"/>
                    <TextBlock Text="Kiểm tra tất cả"/>
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding PasswordCheckMessage}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{Binding PasswordCheckForeground}"/>
              </Grid>

              <Border Background="#F8FAFC" BorderBrush="#E5E7EB"
                      BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <CheckBox Content="Ghi đè file đã tồn tại"
                            IsChecked="{Binding OverwriteExisting}"/>
                  <CheckBox Grid.Column="1" Content="Mở thư mục khi hoàn tất"
                            IsChecked="{Binding OpenFolderWhenDone}"/>
                </Grid>
              </Border>

              <Separator/>

              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap" Foreground="#16A34A"
                         IsVisible="{Binding HasStatusMessage}"/>

              <StackPanel Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right">
                <Button
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding ResetCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource RefreshIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button
                        Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding OpenOutputFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource FolderIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="Mở thư mục output"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button
                        Theme="{StaticResource PrimaryButtonTheme}"
                        Command="{Binding DecryptCommand}"
                        IsEnabled="{Binding !IsDecrypting}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource LockOpenIcon}"
                              Width="15" Height="15"/>
                    <TextBlock Text="Giải mã ngay"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="White"
                  BorderBrush="#D1D5DB" BorderThickness="1"
                  CornerRadius="8" Padding="10">
            <TabControl>
              <TabItem Header="Chi tiết file">
                <Grid Margin="8" MinHeight="245">
                  <TextBlock Text="Chọn một vault trong danh sách để xem chi tiết."
                             Foreground="#6B7280" TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasSelectedItem}"/>
                  <StackPanel Spacing="9" IsVisible="{Binding HasSelectedItem}">
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Vault"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailVaultName}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Tên file gốc"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding DetailOriginalFileName}"
                                 FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Định dạng"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailFormat}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Chế độ"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailMode}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Chunk"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailChunkSize}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="KDF"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailKdf}"
                                 TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Thuật toán"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailAlgorithm}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Dung lượng"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailVaultSize}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Sửa đổi"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailModifiedTime}"/>
                    </Grid>
                    <Grid ColumnDefinitions="110,*">
                      <TextBlock Text="Trạng thái"/>
                      <TextBlock Grid.Column="1" Text="{Binding DetailStatus}"
                                 FontWeight="SemiBold"/>
                    </Grid>
                    <Border Background="#FEF2F2" CornerRadius="4" Padding="8"
                            IsVisible="{Binding HasDetailError}">
                      <TextBlock Text="{Binding DetailError}" Foreground="#B91C1C"
                                 TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Tổng quan">
                <StackPanel Margin="8" MinHeight="245" Spacing="14">
                  <TextBlock Text="Kết quả batch" FontSize="14"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ResultSummary}"
                             TextWrapping="Wrap"/>
                  <Separator/>
                  <TextBlock Text="Thư mục đầu ra" FontSize="11"
                             Foreground="#6B7280"/>
                  <TextBlock Text="{Binding OutputPath}"
                             FontWeight="Medium" TextWrapping="Wrap"/>
                  <TextBlock Text="Mỗi dòng trong danh sách giữ progress và kết quả riêng. Chọn một dòng thất bại để xem nguyên nhân."
                             FontSize="11" Foreground="#6B7280"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" IsVisible="{Binding IsStatusBarVisible}"
            Background="White" BorderBrush="#E3E7EC"
            BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="250,*,56,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{Binding StatusAction}"
                     FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StatusCurrentFile}" FontSize="11"
                     Foreground="#4B5563"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding StatusDetails}" FontSize="11"
                     Foreground="#6B7280"/>
        </StackPanel>
        <ProgressBar Grid.Column="1" Height="8" Margin="16,0"
                     Minimum="0" Maximum="1"
                     Value="{Binding StatusProgress}" CornerRadius="4"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Center"
                   Text="{Binding StatusProgress, StringFormat={}{0:P0}}"/>
        <Button Grid.Column="3" Theme="{StaticResource CancelButtonTheme}"
                Command="{Binding CloseStatusCommand}">
          <PathIcon Data="{StaticResource CancelCircleIcon}"
                    Width="18" Height="18"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
