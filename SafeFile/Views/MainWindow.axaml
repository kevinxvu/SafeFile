<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SafeFile.ViewModels"
        xmlns:loc="using:SafeFile.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="SafeFile.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SafeFile"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Foreground="#1F2937">

  <Window.Resources>

    <!-- ── Nav button ControlTheme ───────────────────────────────────────── -->
    <ControlTheme x:Key="NavButtonTheme" TargetType="Button">
      <Setter Property="Background"              Value="Transparent"/>
      <Setter Property="Foreground"              Value="#4B5563"/>
      <Setter Property="BorderBrush"             Value="Transparent"/>
      <Setter Property="BorderThickness"         Value="3,0,0,0"/>
      <Setter Property="CornerRadius"            Value="0"/>
      <Setter Property="Padding"                 Value="13,11"/>
      <Setter Property="HorizontalAlignment"     Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment"   Value="Center"/>
      <Setter Property="FontSize"                Value="13"/>
      <Setter Property="Cursor"                  Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="#F3F4F6"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="#E5E7EB"/>
      </Style>
      <Style Selector="^.active">
        <Setter Property="Background"  Value="#EFF6FF"/>
        <Setter Property="BorderBrush" Value="#2563EB"/>
        <Setter Property="Foreground"  Value="#2563EB"/>
        <Setter Property="FontWeight"  Value="Medium"/>
      </Style>
      <Style Selector="^.active:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="#DBEAFE"/>
      </Style>
      <Style Selector="^.active:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="#BFDBFE"/>
      </Style>
    </ControlTheme>

  </Window.Resources>

  <Grid ColumnDefinitions="230,*">

    <!-- ═══════════════════════════ SIDEBAR ══════════════════════════════════ -->
    <Border Grid.Column="0"
            Background="White"
            BorderBrush="#E3E7EC" BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- Logo -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal" Spacing="12"
                    Margin="16,22,16,28">
          <Border Width="42" Height="42" CornerRadius="10" Background="#1D4ED8"
                  VerticalAlignment="Center">
            <PathIcon Data="{StaticResource LockIcon}" Width="22" Height="22" Foreground="White"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="SafeFile" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="{loc:Tr AppSubtitle}" FontSize="11" Foreground="#6B7280"/>
          </StackPanel>
        </StackPanel>

        <!-- Nav items -->
        <StackPanel DockPanel.Dock="Top" Spacing="2">

          <Button Theme="{StaticResource NavButtonTheme}"
                  Classes.active="{Binding IsEncryptActive}"
                  Command="{Binding NavigateToEncryptCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource LockIcon}" Width="18" Height="18"/>
              <TextBlock Text="{loc:Tr NavEncrypt}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Theme="{StaticResource NavButtonTheme}"
                  Classes.active="{Binding IsDecryptActive}"
                  Command="{Binding NavigateToDecryptCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource LockOpenIcon}" Width="18" Height="18"/>
              <TextBlock Text="{loc:Tr NavDecrypt}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Theme="{StaticResource NavButtonTheme}"
                  Classes.active="{Binding IsLogsActive}"
                  Command="{Binding NavigateToLogsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource HistoryIcon}" Width="18" Height="18"/>
              <TextBlock Text="{loc:Tr NavLogs}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Theme="{StaticResource NavButtonTheme}"
                  Classes.active="{Binding IsSettingsActive}"
                  Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource SettingsIcon}" Width="18" Height="18"/>
              <TextBlock Text="{loc:Tr NavSettings}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Theme="{StaticResource NavButtonTheme}"
                  Classes.active="{Binding IsAboutActive}"
                  Command="{Binding NavigateToAboutCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="ⓘ" Width="18" FontSize="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{loc:Tr NavAbout}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

        </StackPanel>

        <!-- Filler -->
        <Grid/>
      </DockPanel>
    </Border>

    <!-- ═══════════════════════ MAIN CONTENT ═════════════════════════════════ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="#F8FAFC" BorderBrush="#E3E7EC" BorderThickness="0,0,0,1"
              Padding="16,10">
        <Grid ColumnDefinitions="*">
          <TextBlock Text="{Binding ActivePage}"
                     FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#F4F6F8">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>
    </Grid>

  </Grid>
</Window>

