<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             xmlns:models="using:SafeFile.Models"
             x:Class="SafeFile.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Foreground="{DynamicResource PrimaryTextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16" MaxWidth="1100"
                HorizontalAlignment="Stretch">

      <!-- Appearance -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr Appearance}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr AppearanceHint}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="{loc:Tr Language}" FontWeight="Medium"/>
              <ComboBox ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:LanguageOption">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="8">
              <TextBlock Text="{loc:Tr Theme}" FontWeight="Medium"/>
              <StackPanel Orientation="Horizontal" Spacing="22"
                          MinHeight="32" VerticalAlignment="Center">
                <RadioButton Content="{loc:Tr LightTheme}"
                             IsChecked="{Binding IsLightTheme}"
                             GroupName="ApplicationTheme"/>
                <RadioButton Content="{loc:Tr DarkTheme}"
                             IsChecked="{Binding IsDarkTheme}"
                             GroupName="ApplicationTheme"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <TextBlock Text="{loc:Tr AppearanceApplyHint}"
                     FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
      </Border>

      <!-- Performance -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr Performance}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr PerformanceHint}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="{loc:Tr ChunkSize}" FontWeight="Medium"/>
              <ComboBox ItemsSource="{Binding ChunkSizeOptions}"
                        SelectedItem="{Binding DefaultChunkSizeMb}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat={}{0} MB}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{loc:Tr ChunkSizeHint}"
                         FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr WorkerThreads}" FontWeight="Medium"/>
                <TextBlock Grid.Column="1" Text="{Binding MaxThreads}"
                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
              </Grid>
              <Slider Value="{Binding MaxThreads}" Minimum="1"
                      Maximum="{Binding MaxThreadsLimit}"
                      TickFrequency="1" IsSnapToTickEnabled="True"/>
              <TextBlock Text="{loc:Tr WorkerThreadsHint}"
                         FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Tr CpuPriority}" FontWeight="Medium"/>
            <StackPanel Orientation="Horizontal" Spacing="22">
              <RadioButton Content="{loc:Tr Low}" IsChecked="{Binding IsCpuLow}"
                           GroupName="CpuPriority"/>
              <RadioButton Content="{loc:Tr Normal}" IsChecked="{Binding IsCpuNormal}"
                           GroupName="CpuPriority"/>
              <RadioButton Content="{loc:Tr High}" IsChecked="{Binding IsCpuHigh}"
                           GroupName="CpuPriority"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Security -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr Security}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr SecuritySettingsHint}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0" Spacing="12">
              <TextBlock Text="{loc:Tr PasswordPolicy}" FontWeight="Medium"/>
              <Grid ColumnDefinitions="*,110">
                <TextBlock Text="{loc:Tr MinimumPasswordLength}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MinPasswordLength}"
                               Minimum="6" Maximum="128"
                               Increment="1" FormatString="0"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
              </Grid>
              <CheckBox Content="{loc:Tr RequirePasswordConfirmation}"
                        IsChecked="{Binding ConfirmPasswordToggle}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10">
              <TextBlock Text="Argon2id KDF" FontWeight="Medium"/>
              <Grid ColumnDefinitions="*,110"
                    RowDefinitions="32,32,32"
                    RowSpacing="8">
                <TextBlock Grid.Row="0" Text="{loc:Tr MemoryMb}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding Argon2MemoryMb}"
                               Minimum="{Binding Argon2MemoryMinMb}"
                               Maximum="{Binding Argon2MemoryMaxMb}"
                               Increment="16" FormatString="0"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="1" Text="{loc:Tr Iterations}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding Argon2Iterations}"
                               Minimum="1" Maximum="{Binding Argon2IterationsMax}"
                               Increment="1" FormatString="0"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="2" Text="{loc:Tr Parallelism}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Value="{Binding Argon2Parallelism}"
                               Minimum="1" Maximum="{Binding Argon2ParallelismMax}"
                               Increment="1" FormatString="0"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
              </Grid>
              <TextBlock Text="{loc:Tr KdfHint}"
                         FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Output -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr Output}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr OutputSettingsHint}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="{loc:Tr EncryptedOutputFolder}" FontWeight="Medium"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding DefaultOutputPath}"
                       PlaceholderText="{loc:Tr SelectEncryptedOutputFolder}"/>
              <Button Grid.Column="1" Margin="8,0,0,0"
                      Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding BrowseOutputPathCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="15" Height="15"/>
                  <TextBlock Text="{loc:Tr Browse}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="{loc:Tr DecryptedOutputFolder}" FontWeight="Medium"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding DefaultDecryptOutputPath}"
                       PlaceholderText="{loc:Tr SelectDecryptedOutputFolder}"/>
              <Button Grid.Column="1" Margin="8,0,0,0"
                      Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding BrowseDecryptOutputPathCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="15" Height="15"/>
                  <TextBlock Text="{loc:Tr Browse}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Actions -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,8">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{Binding StatusForeground}"
                   VerticalAlignment="Center" FontWeight="Medium"/>
        <Button Grid.Column="1" Margin="0,0,8,0"
                Theme="{StaticResource OutlinedButtonTheme}"
                Command="{Binding RestoreDefaultsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource RefreshIcon}" Width="15" Height="15"/>
            <TextBlock Text="{loc:Tr RestoreDefaults}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Theme="{StaticResource PrimaryButtonTheme}"
                Command="{Binding SaveCommand}">
          <TextBlock Text="{loc:Tr SaveSettings}"/>
        </Button>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
