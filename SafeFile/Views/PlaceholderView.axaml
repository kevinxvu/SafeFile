<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             x:Class="SafeFile.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Tr FeatureInDevelopment}" Foreground="#757575" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
