<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             x:Class="SafeFile.Views.EncryptView"
             x:DataType="vm:EncryptViewModel"
             Foreground="{DynamicResource PrimaryTextBrush}">
  <UserControl.Styles>
    <Style Selector="Border.source-drop-zone">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
    </Style>
    <Style Selector="Border.source-drop-zone.drag-active">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,16,24,24" Spacing="16">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16"
              IsEnabled="{Binding !IsEncrypting}">
        <StackPanel Spacing="10">
          <Grid>
            <StackPanel Spacing="2">
              <TextBlock Text="{loc:Tr SourceData}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Tr EncryptSelectionHint}" FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
          </Grid>

          <Border Classes="source-drop-zone"
                  BorderThickness="2" CornerRadius="6" Height="120"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragEnter="OnSourceDragEnter"
                  DragDrop.DragLeave="OnSourceDragLeave"
                  DragDrop.DragOver="OnSourceDragOver"
                  DragDrop.Drop="OnSourceDrop">
            <Grid ColumnDefinitions="*,Auto" Margin="22,12">
              <StackPanel VerticalAlignment="Center" Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource FolderIcon}" Width="28" Height="28"
                            Foreground="{DynamicResource SecondaryTextBrush}"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr DropEncryptSources}"
                               FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="{loc:Tr EncryptDropHintMultiple}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SourceDisplayName}" FontSize="12"
                               FontWeight="SemiBold" MaxWidth="520"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentBrush}"
                               IsVisible="{Binding HasSourceInfo}"
                               ToolTip.Tip="{Binding SourceFilesTooltip}"/>
                    <TextBlock Text="{Binding SourcePath}" FontSize="10"
                               MaxWidth="520" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               IsVisible="{Binding HasSourceInfo}"
                               ToolTip.Tip="{Binding SourcePathsTooltip}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasSourceInfo}">
                      <Border Background="{DynamicResource AccentSubtleBrush}"
                              CornerRadius="9" Padding="8,2">
                        <TextBlock Text="{Binding SourceTypeText}" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}"/>
                      </Border>
                      <Border Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" CornerRadius="9" Padding="8,2">
                        <TextBlock Text="{Binding SourceSizeText}" FontSize="10"/>
                      </Border>
                      <Border Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" CornerRadius="9" Padding="8,2">
                        <TextBlock Text="{Binding SourceFileCountText}" FontSize="10"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"
                          VerticalAlignment="Center" Spacing="8">
                <Button Theme="{StaticResource PrimaryButtonTheme}"
                        Command="{Binding BrowseSourceCommand}">
                  <TextBlock Text="{loc:Tr SelectFiles}"/>
                </Button>
                <Button Theme="{StaticResource OutlinedButtonTheme}"
                        Command="{Binding BrowseSourceFolderCommand}">
                  <TextBlock Text="{loc:Tr SelectFolder}"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,16,*" IsEnabled="{Binding !IsEncrypting}">
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Tr Security}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr Password}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding Password}"
                       PasswordChar="{Binding PasswordChar}"/>
              <Button Grid.Column="1" Margin="6,0,0,0" Width="38"
                      Padding="8" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      ToolTip.Tip="{loc:Tr TogglePassword}">
                <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
              </Button>
            </Grid>
            <TextBlock Text="{loc:Tr ConfirmPassword}"
                       IsVisible="{Binding IsPasswordConfirmationRequired}"/>
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsPasswordConfirmationRequired}">
              <TextBox Grid.Column="0" Text="{Binding ConfirmPassword}"
                       PasswordChar="{Binding ConfirmPasswordChar}"/>
              <Button Grid.Column="1" Margin="6,0,0,0" Width="38"
                      Padding="8" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                      ToolTip.Tip="{loc:Tr ToggleConfirmPassword}">
                <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <ProgressBar Grid.Column="0" Value="{Binding PasswordStrength}" Minimum="0" Maximum="100" Height="6"/>
              <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr EncryptionOptions}" FontSize="15" FontWeight="SemiBold"/>
            <CheckBox Content="{loc:Tr EncryptFileNames}"
                      IsChecked="{Binding EncryptFileNames}"/>
            <StackPanel Margin="24,0,0,0"
                        Spacing="6"
                        IsVisible="{Binding EncryptFileNames}">
              <TextBlock Text="{loc:Tr OutputFileNameMethod}"
                         FontSize="12"
                         FontWeight="Medium"/>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="{loc:Tr OutputFileNameAes}"
                             IsChecked="{Binding IsAesOutputFileNameMode}"
                             GroupName="OutputFileNameMode"
                             ToolTip.Tip="{loc:Tr AesOutputFileNameHint}"/>
                <RadioButton Content="{loc:Tr OutputFileNameSha256}"
                             IsChecked="{Binding IsSha256OutputFileNameMode}"
                             GroupName="OutputFileNameMode"
                             ToolTip.Tip="{loc:Tr Sha256OutputFileNameHint}"/>
              </StackPanel>
            </StackPanel>
            <CheckBox Content="{loc:Tr OverwriteSafe}"
                      IsChecked="{Binding OverwriteExisting}"/>
            <StackPanel Spacing="10" IsVisible="{Binding IsFolderSource}">
              <TextBlock Text="{loc:Tr FolderProcessing}" FontWeight="Medium" Margin="0,4,0,0"/>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="{loc:Tr FolderModeZip}" IsChecked="{Binding IsFolderModeZip}" GroupName="FolderMode"/>
                <RadioButton Content="{loc:Tr FolderModePerFile}" IsChecked="{Binding IsFolderModePerFile}" GroupName="FolderMode"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{loc:Tr EstimatedOutput}" FontSize="11"/>
            <TextBlock Text="{Binding EstimatedOutputName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding EstimatedOutputName}"/>
          </StackPanel>
          <Button Grid.Column="1" Margin="12,0,8,0"
                  Theme="{StaticResource OutlinedButtonTheme}"
                  Command="{Binding ResetCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource RefreshIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr Reset}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Margin="0,0,8,0"
                  Theme="{StaticResource OutlinedButtonTheme}"
                  Command="{Binding OpenOutputFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource FolderIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr OpenOutputFolder}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="3"
                  Theme="{StaticResource PrimaryButtonTheme}"
                  Command="{Binding EncryptCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource LockIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr EncryptNow}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                     Text="{Binding StatusMessage}"
                     IsVisible="{Binding HasStatusMessage}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="1"
          IsVisible="{Binding IsStatusBarVisible}"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
          Padding="20,10">
    <Grid ColumnDefinitions="300,*" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusAction}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Text="{Binding StatusDetails}"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="{Binding StatusTiming}"
                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>

      <Grid Grid.Column="1"
            ColumnDefinitions="*,56,Auto"
            RowDefinitions="Auto,Auto"
            RowSpacing="3"
            VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0"
                   Margin="16,0"
                   Text="{Binding StatusCurrentFile}"
                   ToolTip.Tip="{Binding StatusCurrentFilePath}"
                   FontSize="11"
                   Foreground="{DynamicResource TertiaryTextBrush}"
                   TextTrimming="CharacterEllipsis"/>

        <ProgressBar Grid.Column="0" Grid.Row="1"
                     Height="8" VerticalAlignment="Center" Margin="16,0"
                     Minimum="0" Maximum="1" Value="{Binding StatusProgress}"
                     CornerRadius="4"/>

        <TextBlock Grid.Column="1" Grid.Row="1"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding StatusProgressPercent, StringFormat={}{0}%}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}"/>

        <Button Grid.Column="2" Grid.Row="1" VerticalAlignment="Center"
                Theme="{StaticResource CancelButtonTheme}"
                Command="{Binding CloseStatusCommand}"
                ToolTip.Tip="{loc:Tr CancelEncryptionTooltip}">
          <PathIcon Data="{StaticResource CancelCircleIcon}" Width="18" Height="18"/>
        </Button>
      </Grid>
    </Grid>
  </Border>
  </Grid>
</UserControl>
