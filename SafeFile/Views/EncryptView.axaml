<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             x:Class="SafeFile.Views.EncryptView"
             x:DataType="vm:EncryptViewModel"
             Foreground="#1F2937">
  <Grid RowDefinitions="*,Auto">
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <Border Background="White" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{loc:Tr SourceData}" FontSize="15" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <RadioButton Content="{loc:Tr File}" IsChecked="{Binding IsFileSource}" GroupName="SourceType"/>
            <RadioButton Content="{loc:Tr Folder}" IsChecked="{Binding IsFolderSource}" GroupName="SourceType"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SourcePath}" PlaceholderText="{loc:Tr EnterPath}"/>
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Theme="{StaticResource OutlinedButtonTheme}"
                    Command="{Binding BrowseSourceCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource SearchIcon}" Width="15" Height="15"/>
                <TextBlock Text="{loc:Tr Browse}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="8"
                  Height="80" Background="#F5F5F5"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragEnter="OnSourceDragEnter"
                  DragDrop.DragLeave="OnSourceDragLeave"
                  DragDrop.DragOver="OnSourceDragOver"
                  DragDrop.Drop="OnSourceDrop">
            <TextBlock Text="{loc:Tr DropEncryptSource}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888"/>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,16,*">
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Tr Security}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr Password}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding Password}"
                       PasswordChar="{Binding PasswordChar}"/>
              <Button Grid.Column="1" Margin="6,0,0,0" Width="38"
                      Padding="8" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      ToolTip.Tip="{loc:Tr TogglePassword}">
                <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
              </Button>
            </Grid>
            <TextBlock Text="{loc:Tr ConfirmPassword}"
                       IsVisible="{Binding IsPasswordConfirmationRequired}"/>
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsPasswordConfirmationRequired}">
              <TextBox Grid.Column="0" Text="{Binding ConfirmPassword}"
                       PasswordChar="{Binding ConfirmPasswordChar}"/>
              <Button Grid.Column="1" Margin="6,0,0,0" Width="38"
                      Padding="8" Theme="{StaticResource OutlinedButtonTheme}"
                      Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                      ToolTip.Tip="{loc:Tr ToggleConfirmPassword}">
                <PathIcon Data="{StaticResource EyeIcon}" Width="17" Height="17"/>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <ProgressBar Grid.Column="0" Value="{Binding PasswordStrength}" Minimum="0" Maximum="100" Height="6"/>
              <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr EncryptionOptions}" FontSize="15" FontWeight="SemiBold"/>
            <CheckBox Content="{loc:Tr EncryptFileNames}"
                      IsChecked="{Binding EncryptFileNames}"/>
            <CheckBox Content="{loc:Tr OverwriteSafe}"
                      IsChecked="{Binding OverwriteExisting}"
                      IsEnabled="{Binding IsSingleVaultOutput}"/>
            <TextBlock Text="{loc:Tr EncryptedNameHint}"
                       FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Tr FolderProcessing}" FontWeight="Medium" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton Content="{loc:Tr FolderModeZip}" IsChecked="{Binding IsFolderModeZip}" IsEnabled="{Binding IsFolderSource}" GroupName="FolderMode"/>
              <RadioButton Content="{loc:Tr FolderModePerFile}" IsChecked="{Binding IsFolderModePerFile}" IsEnabled="{Binding IsFolderSource}" GroupName="FolderMode"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="White" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{loc:Tr EstimatedOutput}" FontSize="11"/>
            <TextBlock Text="{Binding EstimatedOutputName}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="1" Margin="12,0,8,0"
                  Theme="{StaticResource OutlinedButtonTheme}"
                  Command="{Binding ResetCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource RefreshIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr Reset}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Margin="0,0,8,0"
                  Theme="{StaticResource OutlinedButtonTheme}"
                  Command="{Binding OpenOutputFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource FolderIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr OpenOutputFolder}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="3"
                  Theme="{StaticResource PrimaryButtonTheme}"
                  Command="{Binding EncryptCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource LockIcon}" Width="15" Height="15"/>
              <TextBlock Text="{loc:Tr EncryptNow}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                     Text="{Binding StatusMessage}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="1"
          IsVisible="{Binding IsStatusBarVisible}"
          Background="White" BorderBrush="#E3E7EC" BorderThickness="0,1,0,0"
          Padding="20,10">
    <Grid ColumnDefinitions="250,*,56,Auto" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusAction}"
                   FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
        <TextBlock Text="{Binding StatusCurrentFile}"
                   FontSize="11" Foreground="#4B5563"
                   TextTrimming="CharacterEllipsis" MaxWidth="230"/>
        <TextBlock Text="{Binding StatusDetails}"
                   FontSize="11" Foreground="#6B7280"/>
      </StackPanel>

      <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Margin="16,0"
                   Minimum="0" Maximum="1" Value="{Binding StatusProgress}"
                   CornerRadius="4"/>

      <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                 Text="{Binding StatusProgress, StringFormat={}{0:P0}}"
                 FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>

      <Button Grid.Column="3" VerticalAlignment="Center"
              Theme="{StaticResource CancelButtonTheme}"
              Command="{Binding CloseStatusCommand}"
              ToolTip.Tip="{loc:Tr CancelEncryptionTooltip}">
        <PathIcon Data="{StaticResource CancelCircleIcon}" Width="18" Height="18"/>
      </Button>
    </Grid>
  </Border>
  </Grid>
</UserControl>
