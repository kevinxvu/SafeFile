<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             x:Class="SafeFile.Views.EncryptView"
             x:DataType="vm:EncryptViewModel"
             Foreground="#1F2937">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <Border Background="White" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Nguồn dữ liệu" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <RadioButton Content="Tập tin (File)" IsChecked="{Binding IsFileSource}" GroupName="SourceType"/>
            <RadioButton Content="Thư mục (Folder)" IsChecked="{Binding IsFolderSource}" GroupName="SourceType"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding SourcePath}" Watermark="Nhập đường dẫn"/>
            <Button Grid.Column="1" Content="Duyệt..." Command="{Binding BrowseSourceCommand}"/>
          </Grid>
          <Border BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="8" Height="80" Background="#F5F5F5" DragDrop.AllowDrop="True">
            <TextBlock Text="Kéo thả file hoặc thư mục vào đây" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888"/>
          </Border>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,16,*">
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Bảo mật" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Mật khẩu"/>
            <TextBox Text="{Binding Password}" PasswordChar="{Binding PasswordChar}"/>
            <TextBlock Text="Xác nhận mật khẩu"/>
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="{Binding ConfirmPasswordChar}"/>
            <Grid ColumnDefinitions="*,Auto">
              <ProgressBar Grid.Column="0" Value="{Binding PasswordStrength}" Minimum="0" Maximum="100" Height="6"/>
              <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Tuỳ chọn" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Thuật toán"/>
            <ComboBox IsEnabled="False" SelectedIndex="0">
              <ComboBoxItem Content="AES-256-GCM"/>
            </ComboBox>
            <TextBlock Text="Kích thước Chunk"/>
            <ComboBox ItemsSource="{Binding ChunkSizeOptions}" SelectedItem="{Binding ChunkSizeMb}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Số luồng xử lý (Threads)"/>
              <TextBlock Grid.Column="1" Text="{Binding MaxThreads}"/>
            </Grid>
            <Slider Value="{Binding MaxThreads}" Minimum="1" Maximum="{Binding MaxThreadsLimit}" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="Tuỳ chọn thư mục"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <RadioButton Content="Nén thành 1 file (Zip)" IsChecked="{Binding IsFolderModeZip}" IsEnabled="{Binding IsFolderSource}" GroupName="FolderMode"/>
              <RadioButton Content="Từng file riêng lẻ" IsChecked="{Binding IsFolderModePerFile}" IsEnabled="{Binding IsFolderSource}" GroupName="FolderMode"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="White" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Đầu ra dự kiến" FontSize="11"/>
            <TextBlock Text="{Binding EstimatedOutputName}" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0"/>
          <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0"/>
          <Button Grid.Column="3" Content="Mở thư mục output" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0"/>
          <Button Grid.Column="4" Content="Mã hoá ngay" Command="{Binding EncryptCommand}"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
