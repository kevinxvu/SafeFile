<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SafeFile.ViewModels"
             xmlns:loc="using:SafeFile.Markup"
             x:Class="SafeFile.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Foreground="{DynamicResource PrimaryTextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,16,24,24" Spacing="16"
                HorizontalAlignment="Stretch">

      <!-- Product identity -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="24">
        <Grid ColumnDefinitions="Auto,20,*,Auto">
          <Image Source="/Assets/logo.ico" Width="72" Height="72"
                 Stretch="Uniform" HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Left">
              <TextBlock Text="SafeFile" FontSize="24" FontWeight="Bold"/>
              <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="12" Padding="9,3"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{loc:Tr AboutTagline}" FontSize="14"
                       Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Left"/>
            <TextBlock Text="{loc:Tr AboutDescription}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="650"
                       HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="8">
            <Button Theme="{StaticResource OutlinedButtonTheme}"
                    Command="{Binding CopySystemInfoCommand}">
              <TextBlock Text="{loc:Tr CopySystemInfo}"/>
            </Button>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"
                       FontSize="11" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Core promises -->
      <Grid ColumnDefinitions="*,12,*,12,*">
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
          <StackPanel Spacing="8">
            <Border Width="36" Height="36" CornerRadius="8"
                    Background="{DynamicResource AccentSubtleBrush}"
                    HorizontalAlignment="Left">
              <PathIcon Data="{StaticResource LockIcon}" Width="19" Height="19"
                        Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBlock Text="{loc:Tr AuthenticatedEncryption}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr AuthenticatedEncryptionDescription}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
          <StackPanel Spacing="8">
            <Border Width="36" Height="36" CornerRadius="8"
                    Background="{DynamicResource SuccessSubtleBrush}"
                    HorizontalAlignment="Left">
              <TextBlock Text="⌁" FontSize="21" Foreground="{DynamicResource SuccessBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{loc:Tr StrongKeyDerivation}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr StrongKeyDerivationDescription}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
          <StackPanel Spacing="8">
            <Border Width="36" Height="36" CornerRadius="8"
                    Background="{DynamicResource OrangeSubtleBrush}"
                    HorizontalAlignment="Left">
              <PathIcon Data="{StaticResource FolderIcon}" Width="19" Height="19"
                        Foreground="{DynamicResource OrangeBrush}"/>
            </Border>
            <TextBlock Text="{loc:Tr FlexibleWorkflows}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr FlexibleWorkflowsDescription}"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,12,*">
        <!-- Privacy and trust -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Tr PrivacyAndSecurity}" FontSize="15"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr LocalProcessingDescription}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TertiaryTextBrush}"/>
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Tr PrivacyPointOffline}"/>
              <TextBlock Text="{loc:Tr PrivacyPointPasswords}"/>
              <TextBlock Text="{loc:Tr PrivacyPointIntegrity}"/>
            </StackPanel>
            <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="6" Padding="10">
              <TextBlock Text="{loc:Tr PasswordRecoveryWarning}"
                         Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>

        <!-- Runtime details -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Tr TechnicalInformation}" FontSize="15"
                       FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="135,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="10">
              <TextBlock Text="{loc:Tr OperatingSystem}" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}"
                         TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Text="{loc:Tr Runtime}" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Runtime}"/>
              <TextBlock Grid.Row="2" Text="{loc:Tr Architecture}" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Architecture}"/>
              <TextBlock Grid.Row="3" Text="Avalonia UI" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AvaloniaVersion}"/>
            </Grid>
            <Button Theme="{StaticResource OutlinedButtonTheme}"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenLogFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource FolderIcon}" Width="15" Height="15"/>
                <TextBlock Text="{loc:Tr OpenLogFolder}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Legal footer -->
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="{loc:Tr OpenSourceLicense}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Tr MitLicenseDescription}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="© 2026 kevinxvu" FontWeight="Medium"
                       HorizontalAlignment="Right"/>
            <TextBlock Text="{loc:Tr AllRightsNotice}" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
